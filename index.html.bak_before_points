const Master = (() => {
  function isUnlocked(childId) {
    const c = state.children.find(x => x.id === childId);
    if (!c) return false;
    return (c.weeksCompleted || []).length >= 2;
  }
  function menu() {
    if (!isUnlocked(selectedChildId)) {
      const c = state.children.find(x => x.id === selectedChildId);
      const done = (c?.weeksCompleted || []).length;
      UI.toast(`Complete ${2 - done} more week${2-done!==1?'s':''} to unlock! 🔒`, 'error');
      return;
    }
    const c = state.children.find(x => x.id === selectedChildId);
    document.getElementById('master-pool-count').textContent = `Words in your collection: ${(c.masterPool || []).length}`;
    UI.show('screen-master');
  }
  function startMode(mode) {
    if (mode === 'random') return RandomReview.start(selectedChildId);
    if (mode === 'time') return TimeAttack.setup(selectedChildId);
    if (mode === 'duel') return Duel.setup();
  }
  return { menu, startMode, isUnlocked };
})();

