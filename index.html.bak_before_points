function renderHome() {
  const list = document.getElementById('children-list');
  const modeGrid = document.getElementById('mode-grid');
  list.innerHTML = '';

  if (state.children.length === 0) {
    list.innerHTML = '<p style="text-align:center;color:#999;grid-column:1/-1;padding:20px;">No children yet.<br>Ask your parents to add you in the Parent Panel 👨‍👩‍👧</p>';
    modeGrid.classList.add('hidden');
    return;
  }

  state.children.forEach(c => {
    const div = document.createElement('div');
    div.className = 'child-card' + (c.id === selectedChildId ? ' selected' : '');
    div.innerHTML = `
      <span class="child-avatar">${c.avatar || '👤'}</span>
      <div class="child-name">${c.name}</div>
      <div class="child-points">⭐ ${c.totalPoints || 0}</div>
      <div class="child-badges">${(c.badges || []).join('')}</div>`;
    div.addEventListener('click', () => {
      Audio.click();
      selectedChildId = c.id;
      renderHome();
    });
    list.appendChild(div);
  });

  if (selectedChildId) {
    modeGrid.classList.remove('hidden');
    // Actualizamos contador de Master
    const c = state.children.find(x => x.id === selectedChildId);
    const done = (c?.weeksCompleted || []).length;
    document.getElementById('master-progress-count').textContent = `${Math.min(done,2)}/2`;
    const masterTile = document.getElementById('tile-master');
    if (done >= 2) masterTile.classList.remove('locked');
    else masterTile.classList.add('locked');
  } else {
    modeGrid.classList.add('hidden');
  }
}

