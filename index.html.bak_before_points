<script>
/* ============================================================
   💾 STORAGE
   ============================================================ */
const STORAGE_KEY = 'spellQuest_v4';
const APP_VERSION = 4;

const DEFAULT_STATE = {
  children: [],
  weeks: [],
  activeWeekId: null,
  rewards: [],
  redemptions: [],
  progress: {},
  settings: {
    threshold: 80,
    parentPIN: '1234',
    points: { perWord: 1, perfect: 10, good: 5, low: 0, double: true }
  }
};

let state = loadState();
let selectedChildId = null;

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return migrateFromV3();
    const parsed = JSON.parse(raw);
    return {
      ...DEFAULT_STATE, ...parsed,
      settings: { ...DEFAULT_STATE.settings, ...(parsed.settings||{}), points: { ...DEFAULT_STATE.settings.points, ...((parsed.settings||{}).points||{}) } }
    };
  } catch (e) { return JSON.parse(JSON.stringify(DEFAULT_STATE)); }
}

function migrateFromV3() {
  // Intentar migrar de v3
  try {
    const old = localStorage.getItem('spellQuest_v3');
    if (!old) return JSON.parse(JSON.stringify(DEFAULT_STATE));
    const oldData = JSON.parse(old);
    const newState = JSON.parse(JSON.stringify(DEFAULT_STATE));
    newState.children = (oldData.children || []).map(c => ({
      id: c.id, name: c.name, avatar: c.avatar,
      totalPoints: c.totalPoints || 0,
      badges: c.badges || [],
      history: c.history || [],
      redeemed: c.redeemed || [],
      masterPool: c.masterPool || [],
      weeksCompleted: []
    }));
    // Migrar currentWeek → weeks
    if (oldData.currentWeek && oldData.currentWeek.words && oldData.currentWeek.words.length > 0) {
      const weekId = 'w_' + Date.now();
      newState.weeks.push({
        id: weekId,
        label: oldData.currentWeek.label || 'Semana 1',
        words: [...oldData.currentWeek.words],
        createdAt: new Date().toISOString()
      });
      newState.activeWeekId = weekId;
    }
    newState.rewards = oldData.rewards || [];
    newState.redemptions = oldData.redemptions || [];
    newState.settings = oldData.settings || newState.settings;
    // Migrar progreso: las claves viejas eran childId::weekKey — las renombramos
    newState.progress = {};
    // Simplificación: el progreso antiguo se descarta (el niño empieza de cero en la semana migrada)
    return newState;
  } catch(e) {
    return JSON.parse(JSON.stringify(DEFAULT_STATE));
  }
}

function saveState() { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
function uid() { return Math.random().toString(36).slice(2, 10); }

function getActiveWeek() {
  return state.weeks.find(w => w.id === state.activeWeekId) || state.weeks[0] || null;
}

/* ============================================================
   🐾 AVATARES
   ============================================================ */
const AVATARS = ['🦊','🐼','🦁','🐯','🐨','🐸','🐵','🐶','🐱','🐰','🐻','🐷','🐮','🐔','🐧','🦉','🦄','🐙','🦋','🐢','🐬','🦖','🐝','🦜','🐺'];

/* ============================================================
   🔊 AUDIO
   ============================================================ */
const Audio = (() => {
  let ctx = null;
  function getCtx() { if (!ctx) ctx = new (window.AudioContext || window.webkitAudioContext)(); return ctx; }
  function tone(freq, dur, type='sine', gain=0.15, delay=0) {
    try {
      const c = getCtx(); const start = c.currentTime + delay;
      const osc = c.createOscillator(); const g = c.createGain();
      osc.type = type; osc.frequency.value = freq;
      g.gain.setValueAtTime(gain, start);
      g.gain.exponentialRampToValueAtTime(0.001, start + dur);
      osc.connect(g); g.connect(c.destination); osc.start(start); osc.stop(start + dur);
    } catch(e){}
  }
  return {
    correct() { tone(660,0.12); tone(880,0.18,'sine',0.15,0.1); tone(1100,0.2,'sine',0.12,0.22); },
    wrong() { tone(330,0.15,'sine',0.1); tone(220,0.25,'sine',0.1,0.15); },
    click() { tone(520,0.06,'triangle',0.08); },
    win() { [523,659,784,1046,1318].forEach((f,i)=>tone(f,0.2,'sine',0.15,i*0.12)); }
  };
})();

/* ============================================================
   🗣️ SPEECH
   ============================================================ */
const Speech = (() => {
  let voice = null;
  function pickVoice() {
    const voices = window.speechSynthesis.getVoices();
    voice = voices.find(v => v.lang === 'en-GB') || voices.find(v => v.lang === 'en-US') || voices.find(v => v.lang.startsWith('en'));
  }
  if ('speechSynthesis' in window) { pickVoice(); window.speechSynthesis.onvoiceschanged = pickVoice; }
  function sayWord(text) {
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'en-GB'; u.rate = 0.8; u.pitch = 1.05;
    if (voice) u.voice = voice;
    window.speechSynthesis.speak(u);
  }
  return {
    say(text) {
      if (!text) return;
      if (text.includes('/')) {
        const parts = text.split('/').map(s=>s.trim()).filter(Boolean);
        parts.forEach((p,i)=> setTimeout(()=>sayWord(p), i*1400));
      } else sayWord(text);
    },
    stop() { if ('speechSynthesis' in window) window.speechSynthesis.cancel(); }
  };
})();

/* ============================================================
   🧭 UI
   ============================================================ */
const UI = (() => {
  let navHistory = [];
  function show(id, addToHistory=true) {
    const current = document.querySelector('.screen.active');
    if (current && addToHistory) navHistory.push(current.id);
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    const el = document.getElementById(id);
    if (el) el.classList.add('active');
    window.scrollTo(0,0);
    setTimeout(() => {
      const input = document.getElementById('answer-input');
      if (input && document.getElementById('screen-game').classList.contains('active')) input.focus();
    }, 50);
  }
  function back() {
    const prev = navHistory.pop();
    if (prev) show(prev, false); else show('screen-home', false);
  }
  function toast(msg, type='') {
    const t = document.createElement('div'); t.className = 'toast ' + type; t.textContent = msg;
    document.body.appendChild(t);
    requestAnimationFrame(()=>t.classList.add('show'));
    setTimeout(()=>{ t.classList.remove('show'); setTimeout(()=>t.remove(),500); }, 2400);
  }
  function confetti() {
    const emojis = ['🎉','⭐','✨','🎊','🌟','💫','🎈'];
    for (let i=0; i<25; i++) {
      const c = document.createElement('div'); c.className = 'confetti';
      c.textContent = emojis[Math.floor(Math.random()*emojis.length)];
      c.style.left = Math.random()*100 + 'vw';
      c.style.animationDelay = (Math.random()*0.6) + 's';
      c.style.fontSize = (1.5 + Math.random()*1.8) + 'rem';
      document.body.appendChild(c);
      setTimeout(()=>c.remove(), 3500);
    }
  }
  function modal(html) {
    const overlay = document.getElementById('modal-overlay');
    const box = document.getElementById('modal-box');
    box.innerHTML = html;
    overlay.classList.remove('hidden');
  }
  function closeModal() {
    document.getElementById('modal-overlay').classList.add('hidden');
  }
  return { show, back, toast, confetti, modal, closeModal };
})();

/* ============================================================
   📝 WORDS
   ============================================================ */
const Words = (() => {
  function parse(raw) {
    const lines = raw.split(/[\n;]+/).map(l => l.trim()).filter(Boolean);
    const result = [];
    lines.forEach(line => {
      let wordPart = line;
      const commaIdx = line.lastIndexOf(',');
      if (commaIdx > -1) wordPart = line.slice(0, commaIdx).trim();
      const alts = wordPart.split('/').map(w=>w.trim().toLowerCase()).filter(Boolean);
      if (alts.length > 0) result.push({ alts, display: alts.join(' / ') });
    });
    return result;
  }
  function evaluate(userAnswer, wordObj) {
    const raw = (userAnswer||'').trim();
    if (!raw) return { correct: false, double: false };
    const norm = raw.toLowerCase().replace(/\s*\/\s*/g, '/').replace(/\s+/g, ' ').trim();
    const alts = wordObj.alts;
    if (norm.includes('/')) {
      const parts = norm.split('/').map(s=>s.trim()).filter(Boolean);
      const allValid = parts.length > 0 && parts.every(p => alts.includes(p));
      if (allValid && parts.length === alts.length) return { correct: true, double: true };
      const validParts = parts.filter(p => alts.includes(p));
      if (validParts.length > 0) return { correct: true, double: false };
      return { correct: false, double: false };
    }
    if (alts.includes(norm)) return { correct: true, double: false };
    return { correct: false, double: false };
  }
  return { parse, evaluate };
})();

/* ============================================================
   🎁 REWARDS
   ============================================================ */
const Rewards = (() => {
  function checkBadges(childId) {
    const c = state.children.find(x => x.id === childId);
    if (!c) return [];
    const earned = [];
    const p = c.totalPoints || 0;
    const currentBadges = c.badges || [];
    const tiers = [{min:100,badge:'🥉'},{min:500,badge:'🥈'},{min:1500,badge:'🥇'},{min:3000,badge:'💎'}];
    tiers.forEach(t => { if (p >= t.min && !currentBadges.includes(t.badge)) { currentBadges.push(t.badge); earned.push(t.badge); } });
    c.badges = currentBadges; saveState(); return earned;
  }
  function redeem(childId, reward) {
    const c = state.children.find(x => x.id === childId);
    if (!c || (c.totalPoints||0) < reward.cost) return false;
    c.totalPoints -= reward.cost;
    if (!c.redeemed) c.redeemed = [];
    const entry = { name: reward.name, cost: reward.cost, date: new Date().toISOString(), delivered: false };
    c.redeemed.push(entry);
    state.redemptions.push({ childId, childName: c.name, name: reward.name, cost: reward.cost, date: entry.date, delivered: false });
    saveState(); return true;
  }
  function rejectRedemption(index) {
    if (index < 0 || index >= state.redemptions.length) return false;
    const r = state.redemptions[index];
    const c = state.children.find(x => x.id === r.childId);
    if (!c) return false;
    c.totalPoints = (c.totalPoints || 0) + r.cost;
    if (c.redeemed) {
      const idx = c.redeemed.findIndex(x => x.name === r.name && x.cost === r.cost && !x.delivered);
      if (idx >= 0) c.redeemed.splice(idx, 1);
    }
    state.redemptions.splice(index, 1);
    saveState(); return true;
  }
  return { checkBadges, redeem, rejectRedemption };
})();

/* ============================================================
   🎮 GAME (4 fases para una semana)
   ============================================================ */
const Game = (() => {
  let session = null;
  let timerInterval = null;
  const PHASE3_TIMER = 5;

  function start(childId, weekId) {
    const week = state.weeks.find(w => w.id === weekId);
    if (!week || !week.words || week.words.length === 0) { UI.toast('No words set yet. Ask your parents!', 'error'); return; }
    const parsed = Words.parse(week.words.join('\n'));
    if (parsed.length === 0) { UI.toast('No valid words', 'error'); return; }

    const weekKey = childId + '::' + weekId;
    const saved = state.progress[weekKey];

    if (saved && saved.completed) {
      UI.toast('You already finished this week! 🏆', 'success');
      session = { childId, weekId, week, wordList: parsed, phase: 1, index: 0, correctCount: 0, wrongList: [], startTime: Date.now(), order: [], phasePoints: 0, sessionPoints: 0, weekKey };
      renderReadWords();
      UI.show('screen-read-words');
      return;
    }

    if (saved && !saved.completed) {
      session = {
        childId, weekId, week, wordList: parsed,
        phase: saved.phase || 2,
        index: saved.index || 0,
        correctCount: saved.correctCount || 0,
        wrongList: saved.wrongList || [],
        startTime: Date.now(),
        order: saved.order ? saved.order.map(i => parsed[i]).filter(Boolean) : [],
        phasePoints: saved.phasePoints || 0,
        sessionPoints: saved.sessionPoints || 0,
        weekKey
      };
      if (session.order.length === 0) session.order = shuffle([...parsed]);
      if (session.phase === 1) { renderReadWords(); UI.show('screen-read-words'); }
      else { renderWord(); UI.show('screen-game'); }
      UI.toast('Welcome back! 👋', 'success');
      return;
    }

    session = {
      childId, weekId, week, wordList: parsed, phase: 1, index: 0,
      correctCount: 0, wrongList: [], startTime: Date.now(), order: [],
      phasePoints: 0, sessionPoints: 0, weekKey
    };
    saveProgress();
    renderReadWords();
    UI.show('screen-read-words');
  }

  function saveProgress() {
    if (!session) return;
    const orderIndexes = session.order.map(w => session.wordList.findIndex(x => x.alts.join('/') === w.alts.join('/'))).filter(i => i >= 0);
    state.progress[session.weekKey] = {
      phase: session.phase, index: session.index,
      correctCount: session.correctCount, wrongList: session.wrongList,
      order: orderIndexes, phasePoints: session.phasePoints,
      sessionPoints: session.sessionPoints, completed: false
    };
    saveState();
  }

  function renderReadWords() {
    document.getElementById('read-week-label').textContent = session.week.label || 'Week';
    const list = document.getElementById('words-read-list');
    list.innerHTML = '';
    session.wordList.forEach((w, i) => {
      const div = document.createElement('div');
      div.className = 'word-read-item';
      div.innerHTML = `<span>${i+1}. ${w.display}</span><button data-say="${w.alts[0]}">🔊</button>`;
      list.appendChild(div);
    });
    list.querySelectorAll('[data-say]').forEach(btn => {
      btn.addEventListener('click', () => {
        Audio.click();
        const wordObj = session.wordList.find(w => w.alts[0] === btn.dataset.say);
        if (wordObj) Speech.say(wordObj.alts.join('/'));
      });
    });
  }

  function startPhase() {
    session.index = 0; session.correctCount = 0; session.wrongList = [];
    session.startTime = Date.now(); session.phasePoints = 0;
    session.order = shuffle([...session.wordList]);
    saveProgress();
    renderWord();
    UI.show('screen-game');
  }

  function renderWord() {
    clearInterval(timerInterval);
    const wordObj = session.order[session.index];
    if (!wordObj) { endPhase(); return; }
    const total = session.order.length;
    const phases = {
      2: { title: 'Phase 2: Copy', inst: '📝 Copy this word:', show: 'always' },
      3: { title: 'Phase 3: Listen & Copy', inst: '🎧 Listen & copy (5s):', show: 'timed' },
      4: { title: 'Phase 4: Listen Only', inst: '🎧 Listen and write:', show: 'never' }
    };
    const p = phases[session.phase] || phases[2];
    document.getElementById('game-phase-title').textContent = p.title;
    document.getElementById('game-progress-text').textContent = `${session.index+1} / ${total}`;
    document.getElementById('game-progress-fill').style.width = ((session.index) / total * 100) + '%';
    document.getElementById('game-instruction').textContent = p.inst;

    const wordText = document.getElementById('word-text');
    const wordDisplay = document.getElementById('word-display');
    const audioBtn = document.getElementById('btn-play-audio');
    const input = document.getElementById('answer-input');
    const checkBtn = document.getElementById('btn-check');

    input.value = ''; input.disabled = false; checkBtn.disabled = false;
    setTimeout(() => input.focus(), 100);

    const oldTimer = wordDisplay.querySelector('.timer');
    if (oldTimer) oldTimer.remove();

    if (p.show === 'always') {
      wordText.textContent = wordObj.display;
      wordText.style.display = 'inline';
      wordDisplay.classList.remove('audio-mode');
      audioBtn.classList.remove('hidden'); audioBtn.disabled = false;
      setTimeout(()=>Speech.say(wordObj.alts.join('/')), 400);
    } else if (p.show === 'timed') {
      wordText.textContent = wordObj.display;
      wordText.style.display = 'inline';
      wordDisplay.classList.remove('audio-mode');
      audioBtn.classList.remove('hidden'); audioBtn.disabled = false;
      setTimeout(()=>Speech.say(wordObj.alts.join('/')), 400);
      let remaining = PHASE3_TIMER;
      const timerEl = document.createElement('div');
      timerEl.className = 'timer'; timerEl.textContent = `⏱️ ${remaining}`;
      wordDisplay.appendChild(timerEl);
      timerInterval = setInterval(() => {
        remaining--;
        if (remaining <= 0) {
          clearInterval(timerInterval); timerEl.remove();
          wordText.textContent = '*****';
          wordDisplay.classList.add('audio-mode');
        } else timerEl.textContent = `⏱️ ${remaining}`;
      }, 1000);
    } else {
      wordText.textContent = '*****';
      wordDisplay.classList.add('audio-mode');
      audioBtn.classList.remove('hidden'); audioBtn.disabled = false;
      setTimeout(()=>Speech.say(wordObj.alts.join('/')), 400);
    }
  }

  function playAudio() {
    const wordObj = session.order[session.index];
    Audio.click();
    Speech.say(wordObj.alts.join('/'));
  }

  let isChecking = false;
  function check() {
    if (isChecking) return;
    isChecking = true;
    const input = document.getElementById('answer-input');
    const checkBtn = document.getElementById('btn-check');
    input.disabled = true; checkBtn.disabled = true;
    const userAnswer = input.value.trim();
    const wordObj = session.order[session.index];
    const result = Words.evaluate(userAnswer, wordObj);
    const basePts = state.settings.points.perWord || 1;
    const doubleEnabled = state.settings.points.double !== false;
    let earned = 0;
    if (result.correct) {
      earned = basePts * (result.double && doubleEnabled ? 2 : 1);
      session.correctCount++;
      session.phasePoints += earned;
      saveProgress();
      Audio.correct(); UI.confetti();
      showFeedback(true, wordObj, userAnswer, earned, result.double);
    } else {
      session.wrongList.push({ word: wordObj.display, yours: userAnswer });
      saveProgress();
      Audio.wrong();
      showFeedback(false, wordObj, userAnswer, 0, false);
    }
  }

  function showFeedback(correct, wordObj, yours, earned, doubled) {
    document.getElementById('feedback-icon').textContent = correct ? '🎉' : '💪';
    const title = document.getElementById('feedback-title');
    title.textContent = correct ? 'GREAT JOB!' : 'Almost!';
    title.style.color = correct ? 'var(--success)' : 'var(--warning)';
    const points = document.getElementById('feedback-points');
    if (correct) {
      points.style.display = 'block';
      points.textContent = doubled ? `+${earned} points (DOUBLE! 🌟)` : `+${earned} point${earned!==1?'s':''}`;
    } else points.style.display = 'none';
    const streak = document.getElementById('feedback-streak');
    streak.textContent = (correct && session.correctCount >= 3) ? `🔥 Streak x${session.correctCount}!` : '';
    const corr = document.getElementById('feedback-correction');
    if (correct) corr.classList.add('hidden');
    else {
      corr.classList.remove('hidden');
      document.getElementById('feedback-yours').textContent = yours || '(empty)';
      document.getElementById('feedback-correct').textContent = wordObj.display;
      corr.dataset.word = wordObj.alts.join('/');
    }
    UI.show('screen-feedback');
  }

  function nextWord() {
    isChecking = false;
    session.index++;
    if (session.index >= session.order.length) endPhase();
    else { saveProgress(); renderWord(); UI.show('screen-game'); }
  }

  function endPhase() {
    const total = session.order.length;
    const correct = total - session.wrongList.length;
    const pct = Math.round(correct / total * 100);
    const seconds = Math.round((Date.now() - session.startTime) / 1000);
    const threshold = state.settings.threshold || 80;
    const passed = pct >= threshold;

    let bonus = 0;
    const pts = state.settings.points;
    if (pct === 100) bonus = pts.perfect || 10;
    else if (pct >= 70) bonus = pts.good || 5;
    else bonus = pts.low || 0;

    let phaseTotal = session.phasePoints;
    if (passed) { phaseTotal += bonus; session.sessionPoints += phaseTotal; }

    const phaseNames = { 2: 'Phase 2: Copy', 3: 'Phase 3: Listen & Copy', 4: 'Phase 4: Listen Only' };
    document.getElementById('summary-title').textContent = `${phaseNames[session.phase]} Complete! 🏁`;
    document.getElementById('summary-correct').textContent = `${correct} / ${total}`;
    document.getElementById('summary-accuracy').textContent = pct + '%';
    document.getElementById('summary-points').textContent = passed ? `+${phaseTotal}` + (bonus > 0 ? ` (bonus +${bonus})` : '') : '0 (repeat this phase)';
    document.getElementById('summary-time').textContent = `${Math.floor(seconds/60)}m ${seconds%60}s`;
    const status = document.getElementById('summary-status');
    status.textContent = passed ? '✅ GREAT!' : '💪 Try again!';
    status.className = 'summary-status ' + (passed ? 'passed' : 'failed');

    const review = document.getElementById('summary-review');
    const reviewList = document.getElementById('summary-review-list');
    if (session.wrongList.length > 0) {
      review.classList.remove('hidden');
      reviewList.innerHTML = '';
      session.wrongList.forEach(item => {
        const li = document.createElement('li');
        li.innerHTML = `<strong>${item.word}</strong> — you wrote: <em>${item.yours || '(empty)'}</em>`;
        reviewList.appendChild(li);
      });
    } else review.classList.add('hidden');

    saveProgress();

    if (!passed) {
      document.getElementById('btn-next-phase').style.display = 'none';
      UI.show('screen-phase-summary');
      return;
    }

    if (session.phase === 4) {
      const child = state.children.find(c => c.id === session.childId);
      if (child) {
        child.totalPoints = (child.totalPoints || 0) + session.sessionPoints;
        if (!child.history) child.history = [];
        child.history.push({
          week: session.week.label,
          weekId: session.weekId,
          date: new Date().toISOString(),
          points: session.sessionPoints
        });
        // Añadir palabras al Master Pool del niño
        if (!child.masterPool) child.masterPool = [];
        const poolSet = new Set(child.masterPool.map(w => w.toLowerCase()));
        session.wordList.forEach(w => poolSet.add(w.alts.join('/').toLowerCase()));
        child.masterPool = [...poolSet];
        // Marcar semana completada
        if (!child.weeksCompleted) child.weeksCompleted = [];
        if (!child.weeksCompleted.includes(session.weekId)) child.weeksCompleted.push(session.weekId);
      }
      state.progress[session.weekKey] = { ...(state.progress[session.weekKey]||{}), completed: true };
      saveState();
      Rewards.checkBadges(session.childId);

      setTimeout(() => {
        document.getElementById('week-complete-points').textContent = `+${session.sessionPoints} pts this session`;
        document.getElementById('week-complete-badges').textContent = (child?.badges || []).join(' ');
        renderWeekRewards(child);
        Audio.win(); UI.confetti();
        UI.show('screen-week-complete');
      }, 400);
      return;
    }

    const nextBtn = document.getElementById('btn-next-phase');
    nextBtn.style.display = 'block';
    nextBtn.textContent = `➡ Phase ${session.phase + 1}`;
    UI.show('screen-phase-summary');
  }

  function renderWeekRewards(child) {
    const list = document.getElementById('week-rewards-list');
    list.innerHTML = '';
    if (!child) return;
    if (state.rewards.length === 0) {
      list.innerHTML = '<p style="color:var(--text-soft);">No rewards set yet.</p>';
      return;
    }
    state.rewards.forEach((r) => {
      const canAfford = (child.totalPoints || 0) >= r.cost;
      const div = document.createElement('div');
      div.className = 'reward-card' + (canAfford ? ' affordable' : '');
      div.innerHTML = `
        <div>
          <div class="reward-name">🎁 ${r.name}</div>
          <div class="reward-cost">${r.cost} points</div>
        </div>
        <button class="${canAfford ? 'btn-success' : 'btn-secondary'}" ${canAfford ? '' : 'disabled'}>
          ${canAfford ? 'Redeem' : 'Locked'}
        </button>`;
      const btn = div.querySelector('button');
      if (canAfford) {
        btn.addEventListener('click', () => {
          if (confirm(`Redeem "${r.name}" for ${r.cost} points?`)) {
            if (Rewards.redeem(child.id, r)) {
              Audio.win(); UI.confetti();
              UI.toast(`🎁 Redeemed: ${r.name}!`, 'success');
              renderWeekRewards(child);
            }
          }
        });
      }
      list.appendChild(div);
    });
  }

  function nextPhase() {
    isChecking = false;
    if (session.phase < 4) { session.phase++; startPhase(); }
  }
  function retryPhase() {
    isChecking = false;
    session.index = 0; session.correctCount = 0; session.wrongList = [];
    session.phasePoints = 0; session.startTime = Date.now();
    session.order = shuffle([...session.wordList]);
    saveProgress();
    renderWord();
    UI.show('screen-game');
  }
  function getSession() { return session; }
  function shuffle(arr) {
    for (let i = arr.length-1; i>0; i--) {
      const j = Math.floor(Math.random()*(i+1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    } return arr;
  }

  return { start, startPhase, playAudio, check, nextWord, nextPhase, retryPhase, getSession, renderReadWords };
})();

