  // Backup
  document.getElementById('btn-export-file').addEventListener('click', () => Backup.downloadFile());
  document.getElementById('btn-export-clipboard').addEventListener('click', () => Backup.copyToClipboard());
  document.getElementById('input-import-file').addEventListener('change', (e) => {
    if (e.target.files.length > 0) Backup.importFromFile(e.target.files[0]);
    e.target.value = '';
  });
  document.getElementById('btn-import-clipboard').addEventListener('click', () => Backup.importFromTextarea());

  // Modal
  document.getElementById('modal-overlay').addEventListener('click', (e) => {
    if (e.target.id === 'modal-overlay') UI.closeModal();
  });
});
</script>
</body>
</html>
