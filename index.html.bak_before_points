/* ============================================================
   ⏱️ TIME ATTACK
   ============================================================ */
const TimeAttack = (() => {
  let timer = null;
  let game = null;
  const DURATION = 60;

  function setup(childId) {
    UI.show('screen-time-setup');
    // Guardamos childId para el click
    document.querySelectorAll('[data-time-mode]').forEach(b => {
      b.onclick = () => start(childId, b.dataset.timeMode);
    });
  }

  function start(childId, mode) {
    const c = state.children.find(x => x.id === childId);
    const pool = c.masterPool || [];
    if (pool.length === 0) { UI.toast('No words in pool', 'error'); return; }
    const parsed = Words.parse(pool.join('\n'));
    if (parsed.length === 0) { UI.toast('No valid words', 'error'); return; }

    game = {
      childId, mode, score: 0, best: 0, remaining: DURATION,
      queue: shuffle([...parsed]), current: null,
      startTime: Date.now()
    };
    nextWord();
    UI.show('screen-time-game');
    document.getElementById('time-score-display').textContent = 'Score: 0';
    document.getElementById('time-counter').textContent = DURATION;
    clearInterval(timer);
    timer = setInterval(() => {
      game.remaining--;
      document.getElementById('time-counter').textContent = Math.max(0, game.remaining);
      if (game.remaining <= 0) end();
    }, 1000);
  }

  function nextWord() {
    if (!game) return;
    if (game.queue.length === 0) game.queue = shuffle([...Words.parse((state.children.find(x=>x.id===game.childId).masterPool||[]).join('\n'))]);
    game.current = game.queue.shift();
    const wordText = document.getElementById('time-word-text');
    const wordDisplay = document.getElementById('time-word-display');
    const audioBtn = document.getElementById('btn-time-audio');
    const input = document.getElementById('time-answer-input');
    input.value = ''; input.disabled = false;
    setTimeout(()=>input.focus(), 100);
    wordDisplay.classList.remove('audio-mode');
    if (game.mode === 'copy') {
      document.getElementById('time-instruction').textContent = '📝 Copy this word:';
      wordText.textContent = game.current.display;
      audioBtn.classList.add('hidden');
    } else if (game.mode === 'listen-write') {
      document.getElementById('time-instruction').textContent = '🎧 Listen and write:';
      wordText.textContent = '*****';
      wordDisplay.classList.add('audio-mode');
      audioBtn.classList.remove('hidden');
      setTimeout(()=>Speech.say(game.current.alts.join('/')), 300);
    } else {
      document.getElementById('time-instruction').textContent = '🔊 Listen only:';
      wordText.textContent = '*****';
      wordDisplay.classList.add('audio-mode');
      audioBtn.classList.remove('hidden');
      setTimeout(()=>Speech.say(game.current.alts.join('/')), 300);
    }
  }

  function check() {
    if (!game || !game.current) return;
    const input = document.getElementById('time-answer-input');
    input.disabled = true;
    const result = Words.evaluate(input.value.trim(), game.current);
    if (result.correct) {
      game.score++;
      Audio.correct();
      document.getElementById('time-score-display').textContent = 'Score: ' + game.score;
    } else {
      Audio.wrong();
    }
    setTimeout(() => {
      if (game.remaining > 0) nextWord();
    }, 250);
  }

  function playAudio() { if (game && game.current) { Audio.click(); Speech.say(game.current.alts.join('/')); } }

  function end() {
    clearInterval(timer);
    const pts = game.score;
    const child = state.children.find(c => c.id === game.childId);
    if (child) {
      child.totalPoints = (child.totalPoints || 0) + pts;
      if (!child.bestTimeAttack) child.bestTimeAttack = 0;
      if (game.score > child.bestTimeAttack) child.bestTimeAttack = game.score;
    }
    saveState();
    Rewards.checkBadges(game.childId);
    document.getElementById('time-result-score').textContent = `${game.score} words`;
    document.getElementById('time-result-points').textContent = `+${pts} points`;
    const best = child.bestTimeAttack || 0;
    document.getElementById('time-result-best').textContent = game.score >= best ? '🏅 New personal best!' : `Personal best: ${best}`;
    Audio.win(); UI.confetti();
    UI.show('screen-time-result');
  }

  function playAgain() {
    if (!game) return;
    start(game.childId, game.mode);
  }

  function shuffle(arr) { for (let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];} return arr; }

  return { setup, start, check, playAudio, playAgain };
})();

/* ============================================================
   ⚔️ DUEL
   ============================================================ */
const Duel = (() => {
  let game = null;

  function setup() {
    if (state.children.length < 2) { UI.toast('Necesitas al menos 2 niños', 'error'); return; }
    const list = document.getElementById('duel-players-list');
    list.innerHTML = '';
    state.children.forEach(c => {
      const div = document.createElement('div');
      div.className = 'parent-item';
      div.innerHTML = `<span><input type="checkbox" data-duel-cb="${c.id}" style="width:24px;height:24px;margin-right:10px;">${c.avatar} <strong>${c.name}</strong></span>`;
      list.appendChild(div);
    });
    UI.show('screen-duel-setup');
  }

  function start() {
    const checked = [...document.querySelectorAll('[data-duel-cb]:checked')].map(cb => cb.dataset.duelCb);
    if (checked.length < 2) { UI.toast('Elige al menos 2 jugadores', 'error'); return; }
    const rounds = parseInt(document.getElementById('duel-rounds').value) || 12;

    // Cogemos el pool más pequeño de los jugadores
    const players = checked.map(id => {
      const c = state.children.find(x => x.id === id);
      return { id, name: c.name, avatar: c.avatar, masterPool: c.masterPool || [], score: 0 };
    });
    const smallestPool = players.reduce((min, p) => p.masterPool.length < min.length ? p.masterPool : min, players[0].masterPool);
    if (smallestPool.length === 0) { UI.toast('Algún jugador no tiene palabras en su pool', 'error'); return; }

    const parsed = Words.parse(smallestPool.join('\n'));
    const words = shuffle([...parsed]).slice(0, rounds);

    game = {
      players,
      words,
      rounds: words.length,
      currentRound: 0,
      currentTurnIndex: 0,
      scores: players.map(() => 0),
      mode: 'copy' // Por defecto
    };

    // Mostrar solo 2 jugadores en cabecera (simplificación)
    document.getElementById('duel-p1-avatar').textContent = players[0].avatar;
    document.getElementById('duel-p1-name').textContent = players[0].name;
    document.getElementById('duel-p2-avatar').textContent = players[1].avatar;
    document.getElementById('duel-p2-name').textContent = players[1].name;
    document.getElementById('duel-p1-score').textContent = '0';
    document.getElementById('duel-p2-score').textContent = '0';

    renderTurn();
    UI.show('screen-duel-game');
  }

  function renderTurn() {
    if (!game) return;
    if (game.currentRound >= game.rounds) return end();
    const word = game.words[game.currentRound];
    const player = game.players[game.currentTurnIndex];
    document.getElementById('duel-round-text').textContent = `${game.currentRound+1} / ${game.rounds}`;
    document.getElementById('duel-turn').textContent = `Turn: ${player.avatar} ${player.name}`;
    document.getElementById('duel-instruction').textContent = '📝 Copy this word:';
    document.getElementById('duel-word-text').textContent = word.display;
    document.getElementById('duel-word-display').classList.remove('audio-mode');
    document.getElementById('btn-duel-audio').classList.remove('hidden');
    document.getElementById('duel-answer-input').value = '';
    document.getElementById('duel-answer-input').disabled = false;
    setTimeout(()=>document.getElementById('duel-answer-input').focus(), 100);
  }

  function playAudio() {
    if (!game) return;
    const word = game.words[game.currentRound];
    Audio.click(); Speech.say(word.alts.join('/'));
  }

  let isChecking = false;
  function check() {
    if (isChecking || !game) return;
    isChecking = true;
    const input = document.getElementById('duel-answer-input');
    input.disabled = true;
    const word = game.words[game.currentRound];
    const result = Words.evaluate(input.value.trim(), word);
    if (result.correct) { game.scores[game.currentTurnIndex]++; Audio.correct(); }
    else Audio.wrong();
    updateScores();
    setTimeout(() => {
      isChecking = false;
      game.currentTurnIndex++;
      if (game.currentTurnIndex >= game.players.length) {
        game.currentTurnIndex = 0;
        game.currentRound++;
      }
      if (game.currentRound >= game.rounds) end();
      else renderTurn();
    }, 500);
  }

  function updateScores() {
    if (!game) return;
    document.getElementById('duel-p1-score').textContent = game.scores[0] || 0;
    document.getElementById('duel-p2-score').textContent = game.scores[1] || 0;
  }

  function end() {
    if (!game) return;
    const maxScore = Math.max(...game.scores);
    const winners = game.players.filter((p, i) => game.scores[i] === maxScore);
    const scoreStr = game.scores.join(' - ');
    document.getElementById('duel-result-score').textContent = scoreStr;
    if (winners.length === 1) {
      document.getElementById('duel-result-icon').textContent = '🏆';
      document.getElementById('duel-result-title').textContent = `WINNER: ${winners[0].avatar} ${winners[0].name}!`;
    } else {
      document.getElementById('duel-result-icon').textContent = '🤝';
      document.getElementById('duel-result-title').textContent = '¡EMPATE!';
    }
    // Sumar puntos
    const pointsBox = document.getElementById('duel-result-points');
    pointsBox.innerHTML = '<h3 style="color:var(--primary); margin-bottom:12px;">Points earned:</h3>';
    game.players.forEach((p, i) => {
      const pts = game.scores[i];
      const c = state.children.find(x => x.id === p.id);
      if (c) {
        c.totalPoints = (c.totalPoints || 0) + pts;
      }
      const div = document.createElement('div');
      div.style.marginBottom = '8px';
      div.style.fontSize = '1.2rem';
      div.innerHTML = `${p.avatar} <strong>${p.name}</strong>: +${pts} pts`;
      pointsBox.appendChild(div);
    });
    saveState();
    game.players.forEach(p => Rewards.checkBadges(p.id));
    Audio.win(); UI.confetti();
    UI.show('screen-duel-result');
  }

  function shuffle(arr) { for (let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];} return arr; }

  return { setup, start, check, playAudio };
})();

/* ============================================================
   💾 BACKUP
   ============================================================ */
const Backup = (() => {
  function buildPayload() {
    return { app: 'SpellQuest', version: APP_VERSION, exportedAt: new Date().toISOString(), data: state };
  }
  function downloadFile() {
    const payload = buildPayload();
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    const date = new Date().toISOString().slice(0,10);
    a.href = url; a.download = `spellquest-backup-${date}.json`;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
    UI.toast('📥 Backup descargado', 'success');
  }
  async function copyToClipboard() {
    const text = JSON.stringify(buildPayload(), null, 2);
    try { await navigator.clipboard.writeText(text); UI.toast('📋 Copiado al portapapeles', 'success'); }
    catch (e) {
      const ta = document.getElementById('textarea-import');
      ta.value = text; ta.select();
      UI.toast('📋 Copiado (usa Ctrl+C)', 'success');
    }
  }
  function validatePayload(payload) {
    if (!payload || typeof payload !== 'object') return false;
    if (payload.app !== 'SpellQuest') return false;
    if (!payload.data || typeof payload.data !== 'object') return false;
    return true;
  }
  function applyImport(payload) {
    if (!validatePayload(payload)) { UI.toast('❌ Archivo no válido', 'error'); return; }
    if (!confirm('⚠️ Se REEMPLAZARÁN todos los datos actuales. ¿Continuar?')) return;
    try { localStorage.setItem(STORAGE_KEY + '_backup_before_import', JSON.stringify(buildPayload())); } catch(e){}
    state = { ...DEFAULT_STATE, ...payload.data, settings: { ...DEFAULT_STATE.settings, ...(payload.data.settings||{}), points: { ...DEFAULT_STATE.settings.points, ...((payload.data.settings||{}).points||{}) } } };
    saveState();
    UI.toast('✅ Datos importados', 'success');
    setTimeout(() => location.reload(), 800);
  }
  function importFromFile(file) {
    const reader = new FileReader();
    reader.onload = (e) => {
      try { applyImport(JSON.parse(e.target.result)); }
      catch (err) { UI.toast('❌ JSON inválido', 'error'); }
    };
    reader.readAsText(file);
  }
  function importFromTextarea() {
    const raw = document.getElementById('textarea-import').value.trim();
    if (!raw) { UI.toast('Pega primero los datos', 'error'); return; }
    try { applyImport(JSON.parse(raw)); }
    catch (err) { UI.toast('❌ JSON inválido', 'error'); }
  }
  return { downloadFile, copyToClipboard, importFromFile, importFromTextarea };
})();

