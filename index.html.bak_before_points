      perfect: parseInt(document.getElementById('pts-perfect').value) || 10,
      good: parseInt(document.getElementById('pts-good').value) || 5,
      low: parseInt(document.getElementById('pts-low').value) || 0,
      double: document.getElementById('pts-double').checked
    };
