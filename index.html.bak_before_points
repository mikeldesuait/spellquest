  function addChild() {
    const name = document.getElementById('new-child-name').value.trim();
    if (!name) { UI.toast('Escribe un nombre', 'error'); return; }
    if (!selectedAvatar) { UI.toast('Elige un avatar', 'error'); return; }
    state.children.push({ id: uid(), name, avatar: selectedAvatar, totalPoints: 0, badges: [], history: [], redeemed: [], masterPool: [], weeksCompleted: [] });
    saveState();
    document.getElementById('new-child-name').value = '';
    selectedAvatar = null;
    render(); renderHome(); UI.toast('✅ Niño añadido', 'success');
  }
  function addReward() {
    const name = document.getElementById('new-reward-name').value.trim();
    const cost = parseInt(document.getElementById('new-reward-cost').value);
    if (!name || !cost) { UI.toast('Completa nombre y puntos', 'error'); return; }
    state.rewards.push({ name, cost });
    saveState();
    document.getElementById('new-reward-name').value = '';
    document.getElementById('new-reward-cost').value = '';
    render();
  }
  function savePin() {
    const pin = document.getElementById('new-pin-input').value.trim();
    if (pin.length !== 4 || !/^\d+$/.test(pin)) { UI.toast('PIN debe ser 4 dígitos', 'error'); return; }
    state.settings.parentPIN = pin; saveState(); UI.toast('✅ PIN guardado', 'success');
  }
  function resetProgressAll() {
    if (!confirm('¿Resetear el progreso, puntos, insignias e historial de TODOS los niños?')) return;
    state.children.forEach(c => {
      c.totalPoints = 0; c.badges = []; c.history = []; c.redeemed = [];
      c.masterPool = []; c.weeksCompleted = [];
    });
    state.redemptions = [];
    state.progress = {};
    saveState(); render(); renderHome();
    UI.toast('🔄 Progreso reseteado', 'success');
  }
  function resetAll() {
    if (!confirm('¿SEGURO? Se borrará TODO.')) return;
    if (!confirm('Última oportunidad. ¿Confirmas?')) return;
    localStorage.removeItem(STORAGE_KEY); location.reload();
  }

  return { open, submitPin, render, saveThreshold, savePoints, addChild, addReward, savePin, resetProgressAll, resetAll, renderAvatarPicker, openAddWeekModal };
})();

