<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SpellQuest — A spelling adventure for kids</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
:root {
  --bg1: #a78bfa; --bg2: #60a5fa; --bg3: #f472b6;
  --card: #ffffff; --text: #312e81; --text-soft: #6b7280;
  --primary: #7c3aed; --primary-dark: #5b21b6;
  --success: #34d399; --success-dark: #10b981;
  --warning: #fbbf24; --warning-dark: #d97706;
  --danger: #f472b6; --danger-dark: #ec4899;
  --shadow: 0 8px 24px rgba(124,58,237,0.15);
  --radius: 24px; --radius-sm: 16px;
}
body { font-family: 'Fredoka', 'Comic Sans MS', system-ui, sans-serif; background: linear-gradient(135deg, var(--bg1) 0%, var(--bg2) 50%, var(--bg3) 100%); background-attachment: fixed; color: var(--text); min-height: 100vh; padding: 16px; display: flex; justify-content: center; align-items: flex-start; font-weight: 500; }
.screen { display: none; width: 100%; max-width: 900px; margin: 0 auto; background: var(--card); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow); animation: popIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
.screen.active { display: block; }
@keyframes popIn { from { opacity: 0; transform: scale(0.92) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
@keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
@keyframes wiggle { 0%, 100% { transform: rotate(-5deg); } 50% { transform: rotate(5deg); } }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.top-bar { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
.top-bar h1, .top-bar h2 { font-size: 1.6rem; color: var(--primary); font-weight: 700; }
.title-block h1 { display: flex; align-items: center; gap: 8px; }
.subtitle-tag { font-size: 0.85rem; color: var(--text-soft); font-weight: 500; margin-top: 2px; }
.subtitle { text-align: center; color: var(--text-soft); margin-bottom: 24px; font-size: 1.15rem; }
button { font-family: inherit; cursor: pointer; border: none; border-radius: var(--radius-sm); padding: 14px 22px; font-size: 1.05rem; font-weight: 600; transition: all 0.1s; }
button:active { transform: translateY(4px); box-shadow: 0 2px 0 !important; }
.btn-primary { background: var(--primary); color: #fff; box-shadow: 0 6px 0 var(--primary-dark); }
.btn-primary:hover { background: var(--primary-dark); }
.btn-secondary { background: #f3f4f6; color: var(--text); box-shadow: 0 4px 0 #d1d5db; }
.btn-success { background: var(--success); color: #fff; box-shadow: 0 6px 0 var(--success-dark); }
.btn-icon { background: transparent; font-size: 1.8rem; padding: 6px 12px; box-shadow: none; }
.btn-back { background: #f3f4f6; color: var(--primary); padding: 10px 18px; font-size: 1rem; box-shadow: 0 4px 0 #d1d5db; }
.btn-danger { background: var(--danger); color: #fff; box-shadow: 0 6px 0 var(--danger-dark); }
.btn-warning { background: var(--warning); color: #fff; box-shadow: 0 6px 0 var(--warning-dark); }
.btn-primary.big, .btn-success.big { padding: 18px 36px; font-size: 1.25rem; width: 100%; max-width: 400px; margin: 8px auto; display: block; }
.hidden { display: none !important; }
.children-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; margin-bottom: 24px; }
.child-card { background: linear-gradient(160deg, #ffffff, #f5f3ff); border: 4px solid transparent; border-radius: var(--radius); padding: 20px 12px; text-align: center; cursor: pointer; transition: all 0.2s; box-shadow: 0 6px 0 #ddd6fe; }
.child-card:hover { transform: translateY(-4px); border-color: var(--primary); }
.child-card.selected { border-color: var(--primary); background: linear-gradient(160deg, #ede9fe, #ddd6fe); box-shadow: 0 6px 0 var(--primary-dark); }
.child-avatar { font-size: 3.5rem; display: block; margin-bottom: 8px; animation: bounce 2.5s ease-in-out infinite; }
.child-name { font-weight: 700; font-size: 1.15rem; color: var(--primary); }
.child-points { color: var(--text-soft); font-size: 0.9rem; font-weight: 600; margin-top: 4px; }
.child-badges { font-size: 1.2rem; margin-top: 6px; min-height: 1.4em; letter-spacing: -3px; }
.mode-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 20px; }
.mode-tile { background: linear-gradient(160deg, #f5f3ff, #ffffff); border: 3px solid transparent; border-radius: 20px; padding: 20px 10px; text-align: center; box-shadow: 0 5px 0 #ddd6fe; cursor: pointer; transition: all 0.15s; }
.mode-tile:hover { border-color: var(--primary); transform: translateY(-3px); }
.mode-tile:active { transform: translateY(2px); box-shadow: 0 2px 0 #ddd6fe; }
.mode-tile.locked { opacity: 0.45; cursor: not-allowed; }
.mode-tile.locked:hover { transform: none; border-color: transparent; }
.mode-tile .mode-emoji { font-size: 2.6rem; display: block; margin-bottom: 6px; }
.mode-tile .mode-label { font-weight: 700; font-size: 0.95rem; color: var(--primary); line-height: 1.2; }
.mode-tile .mode-count { font-size: 0.8rem; color: var(--text-soft); margin-top: 2px; }
.stars-btn { position: fixed; top: 20px; right: 80px; z-index: 100; background: var(--warning); color: #fff; box-shadow: 0 4px 0 var(--warning-dark); padding: 10px 16px; font-size: 1rem; border-radius: var(--radius-sm); }
.words-read-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; margin-bottom: 24px; }
.word-read-item { background: linear-gradient(135deg, #fef3c7, #fde68a); border-radius: var(--radius-sm); padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; font-size: 1.15rem; font-weight: 600; box-shadow: 0 4px 0 #fbbf24; }
.word-read-item button { background: #fff; padding: 6px 12px; font-size: 1.3rem; border-radius: 12px; box-shadow: 0 3px 0 #d1d5db; }
.progress-bar { height: 16px; background: #ede9fe; border-radius: 12px; overflow: hidden; margin-bottom: 24px; }
.progress-fill { height: 100%; background: linear-gradient(90deg, var(--success), #6ee7b7); width: 0%; transition: width 0.4s; border-radius: 12px; }
.game-body { text-align: center; }
.word-display { background: linear-gradient(135deg, #ede9fe, #ddd6fe); border-radius: var(--radius); padding: 36px 24px; margin: 20px 0; font-size: 2.4rem; font-weight: 700; color: var(--primary); display: flex; justify-content: center; align-items: center; gap: 16px; min-height: 130px; position: relative; }
.word-display.audio-mode { background: linear-gradient(135deg, #fef3c7, #fde68a); color: #92400e; letter-spacing: 8px; }
.word-display .timer { position: absolute; top: 10px; right: 16px; background: var(--warning); color: #fff; padding: 4px 14px; border-radius: 20px; font-size: 1.1rem; font-weight: 700; }
.answer-input { width: 100%; max-width: 500px; padding: 18px 22px; font-size: 1.5rem; border: 4px solid #ddd6fe; border-radius: var(--radius-sm); text-align: center; font-family: inherit; font-weight: 600; margin: 12px auto 20px; display: block; color: var(--primary); }
.answer-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(124,58,237,0.15); }
.answer-input:disabled { opacity: 0.5; }
.feedback-box, .summary-box, .celebrate-box, .pin-box { text-align: center; padding: 20px; }
.feedback-icon { font-size: 6rem; margin-bottom: 12px; animation: bounce 0.6s ease-in-out; }
.feedback-box h2 { font-size: 2.6rem; margin-bottom: 12px; color: var(--success); font-weight: 700; }
.feedback-points { font-size: 2.4rem; color: var(--success); font-weight: 700; }
.feedback-streak { color: var(--warning); font-weight: 700; margin: 12px 0; font-size: 1.3rem; }
.feedback-correction { background: #fef3c7; border-left: 6px solid var(--warning); border-radius: var(--radius-sm); padding: 20px; margin: 20px 0; text-align: left; font-size: 1.15rem; }
.feedback-correction p { margin: 8px 0; }
.feedback-correction strong { color: var(--danger-dark); font-size: 1.3rem; }
.summary-stats { background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-radius: var(--radius); padding: 24px; margin: 20px 0; font-size: 1.25rem; font-weight: 600; }
.summary-stats p { margin: 10px 0; }
.summary-stats strong { color: var(--success-dark); font-size: 1.4rem; }
.summary-status { font-size: 2rem; font-weight: 700; margin: 20px 0; padding: 12px; border-radius: var(--radius-sm); }
.summary-status.passed { color: var(--success-dark); background: #d1fae5; }
.summary-status.failed { color: var(--danger-dark); background: #fce7f3; }
.summary-review { background: #fef3c7; border-radius: var(--radius-sm); padding: 20px; margin: 16px 0; text-align: left; font-size: 1.1rem; }
.summary-review h3 { color: #92400e; margin-bottom: 10px; }
.summary-review ul { margin-left: 24px; }
.summary-review li { margin: 8px 0; }
.summary-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 24px; }
.celebrate-icon { font-size: 7rem; animation: wiggle 0.8s ease-in-out infinite; }
.big-points { font-size: 2.8rem; color: var(--success); font-weight: 700; margin: 20px 0; }
.badges-row { font-size: 3.5rem; margin: 20px 0; min-height: 4.5rem; letter-spacing: 8px; animation: pulse 1.5s ease-in-out infinite; }
.pin-input { font-size: 2.4rem; text-align: center; letter-spacing: 16px; width: 220px; padding: 16px; border: 4px solid #ddd6fe; border-radius: var(--radius-sm); margin: 12px auto 20px; display: block; font-family: inherit; color: var(--primary); font-weight: 700; }
.pin-input:focus { outline: none; border-color: var(--primary); }
.error-text { color: var(--danger-dark); font-weight: 700; margin-bottom: 12px; font-size: 1.1rem; }
.parent-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 24px; padding-bottom: 12px; border-bottom: 3px solid #f3f4f6; }
.tab { background: transparent; color: var(--text-soft); padding: 10px 16px; border-radius: 12px; font-size: 0.95rem; box-shadow: none; font-weight: 600; }
.tab:hover { background: #f3f4f6; }
.tab.active { background: var(--primary); color: #fff; box-shadow: 0 4px 0 var(--primary-dark); }
.tab-content { display: none; }
.tab-content.active { display: block; animation: popIn 0.3s; }
.tab-content input, .tab-content textarea { width: 100%; padding: 14px; border: 3px solid #e5e7eb; border-radius: var(--radius-sm); font-family: inherit; font-size: 1rem; margin-bottom: 12px; font-weight: 500; color: var(--text); }
.tab-content input:focus, .tab-content textarea:focus { outline: none; border-color: var(--primary); }
.tab-content textarea { min-height: 200px; resize: vertical; font-size: 1.05rem; line-height: 1.6; }
.tab-content h3 { margin: 20px 0 12px; color: var(--primary); font-weight: 700; font-size: 1.15rem; }
.tab-content h4 { margin: 16px 0 8px; color: var(--primary); font-weight: 700; font-size: 1rem; }
.tab-content label { display: block; margin: 14px 0 6px; font-weight: 600; font-size: 1rem; }
.tab-content hr { border: none; border-top: 2px dashed #e5e7eb; margin: 24px 0; }
.info-text { color: var(--success-dark); font-weight: 700; margin-bottom: 12px; font-size: 1.05rem; }
.parent-item { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; background: #f9fafb; border-radius: var(--radius-sm); margin-bottom: 8px; font-weight: 500; flex-wrap: wrap; gap: 8px; }
.parent-item .item-actions { display: flex; gap: 6px; flex-wrap: wrap; }
.parent-item button { padding: 8px 14px; font-size: 0.9rem; border-radius: 12px; }
.parent-item button.del-btn { background: var(--danger); color: #fff; box-shadow: 0 3px 0 var(--danger-dark); }
.parent-item button.reset-btn { background: var(--warning); color: #fff; box-shadow: 0 3px 0 var(--warning-dark); }
.parent-item button.deliver-btn { background: var(--success); color: #fff; box-shadow: 0 3px 0 var(--success-dark); }
.parent-item button.reject-btn { background: #6b7280; color: #fff; box-shadow: 0 3px 0 #374151; }
.parent-item button.edit-btn { background: var(--primary); color: #fff; box-shadow: 0 3px 0 var(--primary-dark); }
.parent-item button.activate-btn { background: #10b981; color: #fff; box-shadow: 0 3px 0 #047857; }
.parent-item.active-week { background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-left: 5px solid var(--success-dark); }
.points-grid { display: grid; grid-template-columns: 1fr 100px; gap: 10px 12px; align-items: center; margin-bottom: 16px; }
.points-grid label { margin: 0; font-size: 0.95rem; }
.points-grid input[type="number"] { margin: 0; padding: 8px 12px; font-size: 1rem; }
.points-grid input[type="checkbox"] { width: 28px; height: 28px; margin: 0; cursor: pointer; }
.avatar-picker { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin: 12px 0 20px; max-width: 500px; }
.avatar-option { background: #f9fafb; border: 3px solid transparent; border-radius: var(--radius-sm); padding: 12px; font-size: 2rem; text-align: center; cursor: pointer; transition: all 0.15s; }
.avatar-option:hover { background: #ede9fe; transform: scale(1.05); }
.avatar-option.selected { background: #ede9fe; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(124,58,237,0.2); transform: scale(1.1); }
.toast { position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-120px); background: var(--text); color: #fff; padding: 16px 28px; border-radius: var(--radius-sm); font-weight: 700; box-shadow: var(--shadow); z-index: 9999; transition: transform 0.4s; font-size: 1.05rem; max-width: 90vw; text-align: center; }
.toast.show { transform: translateX(-50%) translateY(0); }
.toast.success { background: var(--success); }
.toast.error { background: var(--danger); }
.confetti { position: fixed; font-size: 2rem; pointer-events: none; z-index: 9998; animation: fall 3s linear forwards; }
@keyframes fall { 0% { top: -60px; opacity: 1; transform: rotate(0deg) scale(1); } 100% { top: 100vh; opacity: 0; transform: rotate(720deg) scale(0.6); } }
.reward-card { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; background: linear-gradient(135deg, #fef3c7, #fde68a); border-radius: var(--radius-sm); margin-bottom: 12px; box-shadow: 0 4px 0 #fbbf24; }
.reward-card.affordable { background: linear-gradient(135deg, #d1fae5, #a7f3d0); box-shadow: 0 4px 0 #34d399; }
.reward-name { font-weight: 700; font-size: 1.15rem; }
.reward-cost { color: var(--text-soft); font-size: 0.95rem; }
.reward-card button { padding: 10px 18px; font-size: 1rem; }
.reward-card button:disabled { opacity: 0.5; cursor: not-allowed; }
.ranking-row { display: flex; align-items: center; gap: 16px; padding: 16px 20px; background: #f9fafb; border-radius: var(--radius-sm); margin-bottom: 10px; font-size: 1.15rem; font-weight: 600; }
.ranking-row.first { background: linear-gradient(135deg, #fef3c7, #fde68a); box-shadow: 0 4px 0 #fbbf24; }
.ranking-row.second { background: linear-gradient(135deg, #f3f4f6, #e5e7eb); box-shadow: 0 4px 0 #9ca3af; }
.ranking-row.third { background: linear-gradient(135deg, #fed7aa, #fdba74); box-shadow: 0 4px 0 #ea580c; }
.ranking-pos { font-size: 1.6rem; min-width: 40px; }
.ranking-avatar { font-size: 2.2rem; }
.ranking-name { flex: 1; }
.ranking-points { color: var(--success-dark); font-weight: 700; }
.guide-section { text-align: left; line-height: 1.7; }
.guide-section h3 { color: var(--primary); margin-top: 24px; margin-bottom: 8px; font-size: 1.2rem; }
.guide-section h3:first-child { margin-top: 0; }
.guide-section p { margin-bottom: 12px; color: var(--text); }
.guide-section ul { margin-left: 24px; margin-bottom: 12px; }
.guide-section li { margin-bottom: 6px; }
.guide-section code { background: #ede9fe; padding: 2px 8px; border-radius: 6px; font-family: monospace; color: var(--primary-dark); font-size: 0.95em; }
.guide-section .highlight { background: #fef3c7; padding: 14px 18px; border-radius: var(--radius-sm); border-left: 5px solid var(--warning); margin: 16px 0; }
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9997; display: flex; justify-content: center; align-items: center; padding: 20px; animation: fadeIn 0.2s; }
.modal-box { background: #fff; border-radius: var(--radius); padding: 28px; max-width: 600px; width: 100%; max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow); }
.modal-box h2 { color: var(--primary); margin-bottom: 16px; font-size: 1.5rem; }
.modal-box .checkbox-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; font-size: 1.05rem; font-weight: 500; }
.modal-box .checkbox-row input { width: 24px; height: 24px; cursor: pointer; }
.modal-box .modal-actions { display: flex; gap: 12px; justify-content: flex-end; margin-top: 20px; flex-wrap: wrap; }
.wallet-header { text-align: center; padding: 20px; background: linear-gradient(135deg, #fef3c7, #fde68a); border-radius: var(--radius); margin-bottom: 20px; box-shadow: 0 4px 0 #fbbf24; }
.wallet-header h2 { color: var(--warning-dark); font-size: 1.3rem; margin-bottom: 8px; }
.wallet-points { font-size: 2.4rem; font-weight: 700; color: var(--warning-dark); }
.history-list { margin-top: 24px; text-align: left; }
.history-list h3 { color: var(--primary); margin-bottom: 12px; }
.history-item { background: #f9fafb; padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 8px; font-size: 1rem; display: flex; justify-content: space-between; }
.history-item.delivered { color: var(--success-dark); }
.history-item.pending { color: var(--warning-dark); }
.week-card { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; background: #f9fafb; border-radius: var(--radius-sm); margin-bottom: 10px; font-weight: 500; flex-wrap: wrap; gap: 10px; }
.week-card.active { background: linear-gradient(135deg, #d1fae5, #a7f3d0); border-left: 6px solid var(--success-dark); }
.week-card .week-info { flex: 1; min-width: 200px; }
.week-card .week-label { font-weight: 700; font-size: 1.15rem; color: var(--primary); }
.week-card .week-meta { color: var(--text-soft); font-size: 0.9rem; margin-top: 4px; }
.week-card .week-badge { display: inline-block; background: var(--success); color: #fff; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; margin-left: 8px; }
.week-card .week-actions { display: flex; gap: 6px; flex-wrap: wrap; }
.week-card button { padding: 8px 14px; font-size: 0.9rem; border-radius: 12px; }
.week-card button.activate-btn { background: var(--success); color: #fff; box-shadow: 0 3px 0 var(--success-dark); }
.week-card button.edit-btn { background: var(--primary); color: #fff; box-shadow: 0 3px 0 var(--primary-dark); }
.week-card button.del-btn { background: var(--danger); color: #fff; box-shadow: 0 3px 0 var(--danger-dark); }
.duel-header { display: flex; justify-content: space-around; align-items: center; padding: 16px; background: linear-gradient(135deg, #ede9fe, #ddd6fe); border-radius: var(--radius-sm); margin-bottom: 20px; font-size: 1.2rem; font-weight: 700; }
.duel-player { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.duel-player .avatar { font-size: 2.5rem; }
.duel-score { font-size: 1.8rem; color: var(--success-dark); }
.duel-vs { font-size: 1.5rem; color: var(--text-soft); }
.timer-big { text-align: center; font-size: 3rem; font-weight: 700; color: var(--primary); margin: 10px 0 20px; }
.score-big { text-align: center; font-size: 1.8rem; font-weight: 700; color: var(--success-dark); margin-bottom: 20px; }
@media (max-width: 700px) {
  .mode-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 500px) {
  body { padding: 8px; }
  .screen { padding: 16px; border-radius: 20px; }
  .top-bar h1, .top-bar h2 { font-size: 1.25rem; }
  .word-display { font-size: 1.8rem; padding: 24px 16px; min-height: 100px; }
  .answer-input { font-size: 1.3rem; padding: 14px; }
  .children-grid { grid-template-columns: repeat(2, 1fr); }
  .child-avatar { font-size: 2.8rem; }
  .avatar-picker { grid-template-columns: repeat(5, 1fr); gap: 6px; }
  .avatar-option { padding: 8px; font-size: 1.6rem; }
  .summary-actions button { width: 100%; }
  .stars-btn { top: auto; bottom: 16px; right: 16px; }
  .parent-item { flex-direction: column; align-items: flex-start; }
  .week-card { flex-direction: column; align-items: flex-start; }
}

/* ============================================================
   🎨 MODAL - Estilo bonito (Fredoka + colores app)
   ============================================================ */
.modal-box {
  font-family: 'Fredoka', 'Comic Sans MS', system-ui, sans-serif;
  color: var(--text);
}
.modal-box h2 {
  color: var(--primary);
  margin-bottom: 20px;
  font-size: 1.6rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 8px;
}
.modal-box label {
  display: block;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8px;
  margin-top: 16px;
  font-size: 1.05rem;
}
.modal-box label:first-of-type { margin-top: 0; }
.modal-box input[type="text"],
.modal-box input[type="number"],
.modal-box input[type="password"],
.modal-box textarea {
  width: 100%;
  padding: 14px 16px;
  border: 3px solid #ddd6fe;
  border-radius: var(--radius-sm);
  font-family: inherit;
  font-size: 1.05rem;
  font-weight: 500;
  color: var(--text);
  background: #fafaff;
  transition: all 0.15s;
  margin-bottom: 4px;
}
.modal-box input:focus,
.modal-box textarea:focus {
  outline: none;
  border-color: var(--primary);
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(124,58,237,0.15);
}
.modal-box textarea {
  min-height: 220px;
  resize: vertical;
